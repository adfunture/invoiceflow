# --- Infrastruktur ------------------------------------------------------------
APP_ENV=development                 # development | test | production
DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow
LOG_LEVEL=INFO
COOKIE_SECURE=false                 # in Produktion zwingend true
# ALLOWED_HOSTS=invoiceflow.up.railway.app        # mehrere: a.de, b.de (oder JSON-Liste)

# --- Import -------------------------------------------------------------------
IMPORT_START_DATE=2026-11-08        # inklusive, 00:00 in IMPORT_TIMEZONE
IMPORT_TIMEZONE=Europe/Berlin
IMAP_POLL_INTERVAL_SECONDS=300
IMAP_TIMEOUT_SECONDS=60
IMAP_CONNECT_RETRIES=3
MAILBOX_SYNC_LEASE_SECONDS=900

# --- Dokumentenspeicher -------------------------------------------------------
# Schlüssel erzeugen: invoiceflow generate-key  (zusätzlich offline sichern!)
DOCUMENT_ENCRYPTION_KEY=
STORAGE_BACKEND=local               # local (nur Entwicklung) | s3 (Pflicht in Produktion)
STORAGE_LOCAL_PATH=./data/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- KI-Fallback (nur aktiv mit Einstellung ai.enabled=true, erst nach AV-Vertrag) ---
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                    # low | medium | high – Kosten/Gründlichkeit

# --- Überwachung / Alarme -------------------------------------------------------
# PUBLIC_BASE_URL=https://invoiceflow.example.de
# ALERT_EMAIL_TO=it@sbc-symbio.de, info@adfunture.de
# ALERT_EMAIL_FROM=invoiceflow@sbc-symbio.de
# ALERT_SMTP_HOST=smtp.strato.de
# ALERT_SMTP_PORT=465
# ALERT_SMTP_USERNAME=invoiceflow@sbc-symbio.de
# ALERT_SMTP_CREDENTIAL_REF=INVOICEFLOW_SECRET_SMTP_ALERTS
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_TELEGRAM_TOKEN_REF=INVOICEFLOW_SECRET_TELEGRAM_BOT

# --- Datenbank-Backup (eigener Bucket, getrennt vom Dokumentenspeicher) ---------
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT_URL=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=            # Standard: DOCUMENT_ENCRYPTION_KEY
BACKUP_KEEP_DAYS=35

# --- DATEV --------------------------------------------------------------------
# Harte Sendesperre. Erst auf true setzen, wenn die Freigabe-Checkliste im
# Dashboard für das Unternehmen vollständig ist. Zusätzlich gilt der
# Testmodus aus den Einstellungen (Standard: an).
DATEV_ALLOW_REAL_SEND=false

# --- Zugangsdaten (nur als Railway-Variablen, nie in die DB) ------------------
# Die Namen stehen in mailboxes.credential_ref bzw. datev_destinations.smtp_credential_ref.
INVOICEFLOW_SECRET_IMAP_SBC_MAIL=
INVOICEFLOW_SECRET_IMAP_SBC_SENNINGER=
INVOICEFLOW_SECRET_IMAP_SBC_INVOICE=
INVOICEFLOW_SECRET_IMAP_ADFUNTURE_INFO=
INVOICEFLOW_SECRET_IMAP_ADFUNTURE_INVOICE=
# SMTP-Absender für DATEV Upload Mail (Name frei wählbar, im Dashboard eintragen)
# INVOICEFLOW_SECRET_SMTP_ADFUNTURE_INVOICE=
# INVOICEFLOW_SECRET_SMTP_SBC_INVOICE=
