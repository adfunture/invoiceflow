{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["sh -c 'invoiceflow migrate && invoiceflow seed'"],
    "startCommand": "sh -c 'uvicorn invoiceflow.api.app:app --host 0.0.0.0 --port ${PORT:-8080} --no-server-header'",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
