{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'invoiceflow ops backup && invoiceflow ops verify-storage --sample 50'",
    "cronSchedule": "30 1 * * *",
    "restartPolicyType": "NEVER"
  }
}
